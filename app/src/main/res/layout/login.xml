<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/hospital_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/hospital_white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hospital Login"
            android:textStyle="bold"
            android:textSize="26sp"
            android:textColor="@color/hospital_dark_blue"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/welcomeMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to the Hospital App"
            android:textSize="14sp"
            android:textColor="@color/hospital_secondary_text"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username"
            android:textColor="@color/hospital_text"
            android:textColorHint="@color/hospital_secondary_text" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:textColor="@color/hospital_text"
            android:textColorHint="@color/hospital_secondary_text" />

        <Spinner
            android:id="@+id/list_view_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/role"
            android:layout_marginTop="8dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/loginButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Login"
                android:textColor="@color/hospital_white"
                android:backgroundTint="@color/hospital_blue" />

            <Button
                android:id="@+id/CreateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Create Account"
                android:textColor="@color/hospital_white"
                android:backgroundTint="@color/hospital_teal" />

        </RelativeLayout>

    </LinearLayout>

</LinearLayout>