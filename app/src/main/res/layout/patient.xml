<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/hospital_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Dashboard"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/hospital_dark_blue"
        android:layout_marginBottom="8dp" />

    <!-- Welcome message -->
    <TextView
        android:id="@+id/patientWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome, Patient"
        android:textSize="18sp"
        android:textColor="@color/hospital_secondary_text"
        android:layout_marginBottom="20dp" />

    <!-- Upcoming appointments -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:padding="20dp"
        android:orientation="vertical"
        android:background="@color/hospital_white">

        <TextView
            android:id="@+id/appointmentsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upcoming Appointments"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/hospital_dark_blue" />

        <LinearLayout
            android:id="@+id/appointmentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/appointment1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="05/10/2026 - 10:00 - Dr. Ahmed"
                android:textSize="16sp"
                android:textColor="@color/hospital_text"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/appointment2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="12/10/2026 - 14:30 - Dr. Sara"
                android:textSize="16sp"
                android:textColor="@color/hospital_text"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Book an appointment button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:padding="20dp"
        android:background="@color/hospital_white">

        <Button
            android:id="@+id/AppointmentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:backgroundTint="@color/hospital_blue"
            android:text="Book an appointment"
            android:textColor="@color/hospital_white" />

    </RelativeLayout>

</LinearLayout>