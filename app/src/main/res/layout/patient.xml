<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/hospital_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Dashboard"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/hospital_dark_blue"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/patientWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome, Patient"
        android:textSize="18sp"
        android:textColor="@color/hospital_secondary_text"
        android:layout_marginBottom="20dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@color/hospital_white">

        <TextView
            android:id="@+id/doctorsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Doctors"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/hospital_dark_blue" />

        <TextView
            android:id="@+id/doctor1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/doctorsTitle"
            android:layout_marginTop="12dp"
            android:text="Dr. Ahmed - Cardiologist"
            android:textSize="16sp"
            android:textColor="@color/hospital_text" />

        <TextView
            android:id="@+id/doctor2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/doctor1"
            android:layout_marginTop="8dp"
            android:text="Dr. Sara - General Practitioner"
            android:textSize="16sp"
            android:textColor="@color/hospital_text" />

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:padding="20dp"
        android:background="@color/hospital_white">

        <TextView
            android:id="@+id/appointmentsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upcoming Appointments"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/hospital_dark_blue" />

        <TextView
            android:id="@+id/appointment1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/appointmentsTitle"
            android:layout_marginTop="12dp"
            android:text="05/10/2026 - 10:00 - Dr. Ahmed"
            android:textSize="16sp"
            android:textColor="@color/hospital_text" />

        <TextView
            android:id="@+id/appointment2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/appointment1"
            android:layout_marginTop="8dp"
            android:text="12/10/2026 - 14:30 - Dr. Sara"
            android:textSize="16sp"
            android:textColor="@color/hospital_text" />

    </RelativeLayout>

</LinearLayout>