<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/hospital_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Doctor Dashboard"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/hospital_dark_blue"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/doctorWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome, Doctor"
        android:textSize="18sp"
        android:textColor="@color/hospital_secondary_text"
        android:layout_marginBottom="20dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@color/hospital_white">

        <TextView
            android:id="@+id/patientsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Patients"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/hospital_dark_blue" />

        <TextView
            android:id="@+id/patient1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/patientsTitle"
            android:layout_marginTop="12dp"
            android:text="Patient 1 - Regular Check-up"
            android:textSize="16sp"
            android:textColor="@color/hospital_text" />

        <TextView
            android:id="@+id/patient2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/patient1"
            android:layout_marginTop="8dp"
            android:text="Patient 2 - Follow-up"
            android:textSize="16sp"
            android:textColor="@color/hospital_text" />

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:padding="20dp"
        android:background="@color/hospital_white">

        <TextView
            android:id="@+id/appointmentsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's Appointments"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/hospital_dark_blue" />

        <TextView
            android:id="@+id/appointment1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/appointmentsTitle"
            android:layout_marginTop="12dp"
            android:text="10:00 - Patient 1"
            android:textSize="16sp"
            android:textColor="@color/hospital_text" />

        <TextView
            android:id="@+id/appointment2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/appointment1"
            android:layout_marginTop="8dp"
            android:text="14:30 - Patient 2"
            android:textSize="16sp"
            android:textColor="@color/hospital_text" />

    </RelativeLayout>

</LinearLayout>